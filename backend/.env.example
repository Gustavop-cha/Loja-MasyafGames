# Copie este arquivo para "backend/.env" e preencha com os dados do seu projeto no Neon.
# No console do Neon: Dashboard > Connect > escolha "Java" (ou copie a connection string e adapte).
#
# Connection string do Neon:   postgresql://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Vira, em formato JDBC:      jdbc:postgresql://ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# (usuário e senha vão separados, nas variáveis abaixo)

DB_URL=jdbc:postgresql://ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=sua_senha_aqui

# E-mail do usuário que terá acesso à área Admin (precisa estar cadastrado no site)
ADMIN_EMAIL=seu_email@exemplo.com
